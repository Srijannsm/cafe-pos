# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cafepos?schema=public"

# Two DIFFERENT long random secrets (32+ chars each; the API refuses to start
# in production otherwise). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
PLATFORM_JWT_SECRET=""

# The web app's URL(s), comma-separated. Required in production.
CORS_ORIGIN="http://localhost:3000"

PORT=4000
NODE_ENV=development

# Used once by `npm run seed` to create the platform superadmin.
SUPERADMIN_USERNAME=""
SUPERADMIN_PASSWORD=""

# Only for `npm run test:e2e` -- a LOCAL Postgres the tests may create/drop databases on.
# E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
