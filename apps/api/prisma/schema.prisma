// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  cashier
  waiter
}

enum TableStatus {
  free
  occupied
  reserved
}

enum OrderType {
  dine_in
  takeaway
}

enum OrderStatus {
  pending
  preparing
  served
  billed
  paid
  cancelled
}

enum OrderItemStatus {
  pending
  ready
  served
}

enum PaymentMethod {
  cash
  esewa_qr
  khalti_qr
  fonepay_qr
}

// Which prep screen (KDS column / printed ticket) an item goes to. A cafe
// with a hookah corner or a separate bar gets each station's tickets on its
// own screen (/kitchen?station=bar) instead of one long mixed list.
enum Station {
  kitchen
  bar
  hookah
}

// Where an order came from -- lets reports split staff-taken vs QR orders.
enum OrderSource {
  staff
  qr
}

enum DiscountType {
  percent
  flat
}

enum CashMovementType {
  pay_in
  pay_out
  expense
}

// Inventory: what kind of thing a stock item is. Ingredients get used up by
// recipes, consumables (hookah coils, foil, napkins) get used up by recipe
// or a manual stock-out, assets (glasses, plates, cutlery) only ever leave
// stock through breakage/loss.
enum StockKind {
  ingredient
  consumable
  asset
}

// Every change to a stock item's quantity is one of these. StockItem.currentQty
// is just a cached running total of its movements -- the movements are the
// real record (an append-only ledger, never edited or deleted).
enum StockMovementType {
  opening
  purchase
  sale
  wastage
  breakage
  staff_use
  adjustment
  count
}

enum TableRequestType {
  call_waiter
  request_bill
}

// The tenant. Every cafe running on this deployment gets one row here, and
// (almost) every other model hangs off a cafeId so one cafe's data is never
// visible to another. `slug` is what identifies a cafe in the URL
// (/c/:slug/login) since staff log in with a 4-digit PIN, not an email --
// the slug is how the app knows *which* cafe's staff list to show.
// A superadmin who can manage cafes through the internal /platform panel.
// Deliberately separate from User (per-cafe staff, PIN login) -- platform
// users aren't scoped to any cafe and authenticate with a real
// username/password instead.
model PlatformUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("platform_users")
}

enum SubscriptionPlan {
  starter
  standard
  premium

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  trial
  active
  overdue
  cancelled

  @@map("subscription_status")
}

model Cafe {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // VAT settings -- opt-in per cafe. Non-VAT cafes leave vatEnabled false
  // and the billing/receipt logic stays exactly as before. VAT-registered
  // cafes set vatEnabled true, vatRate (default 13 for Nepal), and panNumber.
  vatEnabled Boolean  @default(false)
  vatRate    Decimal  @default(13)
  panNumber      String?
  lastBillNumber Int     @default(0)

  // Logo
  logoUrl        String?
  themeColor     String?  // hex, e.g. "#e85d26"

  // Branding / "vibe" -- shown on the QR menu and receipts. Everything else
  // (spacing, type scale, status colours) stays system-controlled so every
  // tenant still looks polished.
  coverImageUrl  String?
  tagline        String?
  fontStyle      String   @default("modern") // modern | warm | playful
  menuLayout     String   @default("grid")   // grid | list
  phone          String?
  address        String?
  wifiName       String?
  wifiPassword   String?
  instagram      String?
  facebook       String?
  tiktok         String?
  receiptFooter  String?

  // Billing behaviour. Service charge defaults to 0 (see CLAUDE.md -- its
  // legal status in Nepal is unsettled); pricesIncludeVat lets a VAT cafe
  // print menu prices as-is and back-calculate VAT instead of adding on top.
  serviceChargeRate Decimal @default(0)
  pricesIncludeVat  Boolean @default(false)

  // Feature toggles
  inventoryEnabled Boolean @default(true)
  gamesEnabled     Boolean @default(false)

  // Subscription
  plan               SubscriptionPlan    @default(starter)
  billingCycle       String              @default("monthly") // "monthly" | "yearly"
  subscriptionStatus SubscriptionStatus  @default(trial)
  trialStartedAt     DateTime            @default(now())
  nextBillingAt      DateTime?
  setupFeePaid       Boolean             @default(false)
  subscriptionNotes  String?

  users          User[]
  tables         RestaurantTable[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  orders         Order[]
  shifts         Shift[]
  cashMovements  CashMovement[]
  stockItems     StockItem[]
  suppliers      Supplier[]
  purchases      Purchase[]
  stockMovements StockMovement[]
  auditLogs      AuditLog[]
  tableRequests  TableRequest[]

  @@map("cafes")
}

model User {
  id       Int     @id @default(autoincrement())
  cafeId   Int
  name     String
  pinHash  String
  role     Role
  isActive Boolean @default(true)

  cafe   Cafe    @relation(fields: [cafeId], references: [id])
  orders Order[]
  shiftsOpened Shift[] @relation("ShiftOpenedBy")
  shiftsClosed Shift[] @relation("ShiftClosedBy")

  // A name only has to be unique within its own cafe -- "Sita" can work at
  // two different cafes on the same platform.
  @@unique([cafeId, name])
  @@map("users")
}

model RestaurantTable {
  id          Int         @id @default(autoincrement())
  cafeId      Int
  tableNumber String
  capacity    Int
  status      TableStatus @default(free)

  // Printed as a QR code -- the *token*, not the table id or tableNumber,
  // is what grants access to /c/:slug/order/:qrToken, so a customer can't
  // reach (or guess their way into) another table's order by trying
  // sequential numbers. Rotatable via the admin "regenerate QR" action if
  // a printed code is ever compromised.
  qrToken String @unique @default(cuid())

  // Physical table merge: when set, this table has been absorbed into
  // another (the primary) table for a combined seating/order. The secondary
  // table's status is set to 'reserved' so it's hidden from the floor view.
  // The primary table's mergedFrom relation lists all tables absorbed into it.
  mergedIntoId  Int?
  mergedInto    RestaurantTable?  @relation("TableMerge", fields: [mergedIntoId], references: [id])
  mergedFrom    RestaurantTable[] @relation("TableMerge")

  cafe     Cafe           @relation(fields: [cafeId], references: [id])
  orders   Order[]
  requests TableRequest[]

  @@unique([cafeId, tableNumber])
  @@map("restaurant_tables")
}

model MenuCategory {
  id        Int     @id @default(autoincrement())
  cafeId    Int
  name      String
  sortOrder Int
  isActive  Boolean @default(true)

  // Sub-categories: a category with a parentId is a sub-category of that
  // parent (Drinks -> Hot / Cold / Shakes). Kept to two levels on purpose
  // (enforced in MenuService) -- deeper trees make the waiter screen slower,
  // not faster.
  parentId  Int?
  parent    MenuCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  MenuCategory[] @relation("CategoryTree")

  cafe      Cafe       @relation(fields: [cafeId], references: [id])
  menuItems MenuItem[]

  @@unique([cafeId, name])
  @@map("menu_categories")
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  cafeId      Int
  name        String
  price       Decimal
  isAvailable Boolean  @default(true)
  categoryId  Int

  description String?
  imageUrl    String?
  // Small fixed vocabulary (veg, nonveg, spicy, bestseller, new, vegan) --
  // validated in the DTO rather than a DB enum so adding a tag later
  // doesn't need a migration.
  tags        String[] @default([])
  station     Station  @default(kitchen)
  sortOrder   Int      @default(0)
  // Optional manual cost price, for a rough margin in reports until recipes
  // (RecipeLine) carry the real ingredient cost.
  costPrice   Decimal?

  // Inventory tracking is opt-in per item (trackStock) -- most cafe menu
  // items (drinks made to order, say) never run out in a way worth
  // tracking, so items default to untracked rather than forcing every
  // item to carry a meaningless stock count. stockQuantity/
  // lowStockThreshold are only meaningful once trackStock is true.
  trackStock        Boolean @default(false)
  stockQuantity     Int     @default(0)
  lowStockThreshold Int     @default(5)

  cafe       Cafe         @relation(fields: [cafeId], references: [id])
  category   MenuCategory @relation(fields: [categoryId], references: [id])
  modifiers  Modifier[]
  orderItems OrderItem[]
  recipe     RecipeLine[]

  @@unique([cafeId, name])
  @@map("menu_items")
}

model Modifier {
  id         Int     @id @default(autoincrement())
  name       String
  priceDelta Decimal
  menuItemId Int

  // Scoped to its cafe transitively through menuItem -- a modifier never
  // needs to be looked up on its own without its parent item, so a direct
  // cafeId here would just be a redundant column to keep in sync.
  menuItem           MenuItem            @relation(fields: [menuItemId], references: [id])
  orderItemModifiers OrderItemModifier[]

  @@map("modifiers")
}

model Order {
  id        Int         @id @default(autoincrement())
  cafeId    Int
  orderType OrderType
  status    OrderStatus @default(pending)
  total     Decimal?
  // Set at bill-generation time. Only populated when cafe.vatEnabled.
  subtotal  Decimal?
  vatAmount  Decimal?
  billNumber Int?
  createdAt DateTime    @default(now())
  tableId   Int
  // Nullable: a customer placing their own order via table QR has no
  // waiter to attribute it to yet. Everything else about the order works
  // exactly the same either way -- staff still confirm, cook, serve, and
  // bill it through the normal flow.
  waiterId  Int?
  notes     String?

  source    OrderSource @default(staff)

  // Bill-level discount. discountAmount is the computed money value frozen
  // at bill time; type/value are what the cashier entered.
  discountType   DiscountType?
  discountValue  Decimal?
  discountAmount Decimal?
  discountReason String?
  serviceCharge  Decimal?
  // How many times the bill was printed -- reprints say "COPY OF ORIGINAL".
  printCount     Int     @default(0)
  cancelReason   String?

  cafe       Cafe            @relation(fields: [cafeId], references: [id])
  table      RestaurantTable @relation(fields: [tableId], references: [id])
  waiter     User?           @relation(fields: [waiterId], references: [id])
  orderItems OrderItem[]
  payments   Payment[]

  @@map("orders")
}

model OrderItem {
  id              Int             @id @default(autoincrement())
  quantity        Int             @default(1)
  price           Decimal
  status          OrderItemStatus @default(pending)
  sentToKitchen   Boolean         @default(false)
  orderId         Int
  menuItemId      Int
  note            String?
  station         Station         @default(kitchen)
  createdAt       DateTime        @default(now())

  // Void (item removed after it reached the kitchen). The row is kept --
  // never deleted -- so the kitchen sees the strike-through and the
  // discounts & voids report can show who removed what and why.
  voidedAt        DateTime?
  voidReason      String?
  voidedById      Int?

  // Scoped transitively through order, same reasoning as Modifier above.
  order              Order               @relation(fields: [orderId], references: [id])
  menuItem           MenuItem            @relation(fields: [menuItemId], references: [id])
  orderItemModifiers OrderItemModifier[]

  @@map("order_items")
}

model OrderItemModifier {
  id          Int @id @default(autoincrement())
  orderItemId Int
  modifierId  Int

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  modifier  Modifier  @relation(fields: [modifierId], references: [id])

  @@unique([orderItemId, modifierId])
  @@map("order_item_modifiers")
}

model Payment {
  id      Int           @id @default(autoincrement())
  amount  Decimal
  method  PaymentMethod
  paidAt  DateTime      @default(now())
  orderId Int
  // A bill can be settled by several payments (Rs 500 cash + Rs 740 Fonepay).
  reference    String?
  receivedById Int?
  shiftId      Int?
  shift        Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  // Scoped transitively through order, same reasoning as Modifier above.
  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// ── Cash drawer ─────────────────────────────────────────────────────────
// One open shift per cafe at a time. Close = count the drawer; the
// difference against expected cash (opening + cash sales + pay-ins -
// pay-outs/expenses) is frozen on the row.
model Shift {
  id           Int       @id @default(autoincrement())
  cafeId       Int
  openedById   Int
  openedAt     DateTime  @default(now())
  openingCash  Decimal
  closedById   Int?
  closedAt     DateTime?
  expectedCash Decimal?
  countedCash  Decimal?
  difference   Decimal?
  note         String?

  cafe          Cafe           @relation(fields: [cafeId], references: [id])
  openedBy      User           @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy      User?          @relation("ShiftClosedBy", fields: [closedById], references: [id])
  payments      Payment[]
  cashMovements CashMovement[]

  @@index([cafeId, closedAt])
  @@map("shifts")
}

// Money in/out of the drawer that isn't a sale. An `expense` is a pay-out
// with a category (milk delivery, gas, staff snacks) -- that's what turns
// petty cash into a simple expense report.
model CashMovement {
  id          Int              @id @default(autoincrement())
  cafeId      Int
  shiftId     Int?
  type        CashMovementType
  category    String?
  amount      Decimal
  note        String?
  createdById Int?
  createdAt   DateTime         @default(now())

  cafe  Cafe   @relation(fields: [cafeId], references: [id])
  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([cafeId, createdAt])
  @@map("cash_movements")
}

// ── Inventory ───────────────────────────────────────────────────────────
model StockItem {
  id                Int       @id @default(autoincrement())
  cafeId            Int
  name              String
  kind              StockKind @default(ingredient)
  unit              String    // g, kg, ml, L, pcs, pack ...
  currentQty        Decimal   @default(0)
  // Weighted average cost per unit, recalculated on every purchase.
  avgCost           Decimal   @default(0)
  lowStockThreshold Decimal   @default(0)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())

  cafe          Cafe            @relation(fields: [cafeId], references: [id])
  movements     StockMovement[]
  purchaseLines PurchaseLine[]
  recipeLines   RecipeLine[]

  @@unique([cafeId, name])
  @@map("stock_items")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  cafeId    Int
  name      String
  phone     String?
  panNumber String?
  note      String?
  createdAt DateTime @default(now())

  cafe      Cafe       @relation(fields: [cafeId], references: [id])
  purchases Purchase[]

  @@unique([cafeId, name])
  @@map("suppliers")
}

model Purchase {
  id          Int      @id @default(autoincrement())
  cafeId      Int
  supplierId  Int?
  purchasedAt DateTime @default(now())
  billRef     String?
  total       Decimal
  note        String?
  createdById Int?
  createdAt   DateTime @default(now())

  cafe     Cafe           @relation(fields: [cafeId], references: [id])
  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lines    PurchaseLine[]

  @@index([cafeId, purchasedAt])
  @@map("purchases")
}

model PurchaseLine {
  id          Int     @id @default(autoincrement())
  purchaseId  Int
  stockItemId Int
  quantity    Decimal
  unitCost    Decimal
  lineTotal   Decimal

  purchase  Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@map("purchase_lines")
}

model StockMovement {
  id          Int               @id @default(autoincrement())
  cafeId      Int
  stockItemId Int
  type        StockMovementType
  // Signed: +10 for a purchase, -3 for breakage.
  quantity    Decimal
  unitCost    Decimal?
  reason      String?
  refType     String?           // "purchase" | "order" | "count"
  refId       Int?
  createdById Int?
  createdAt   DateTime          @default(now())

  cafe      Cafe      @relation(fields: [cafeId], references: [id])
  stockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@index([cafeId, createdAt])
  @@index([stockItemId, createdAt])
  @@map("stock_movements")
}

// "One cappuccino uses 18 g beans + 150 ml milk". Optional -- when a menu
// item has recipe lines, paying for it posts `sale` movements that deduct
// the ingredients automatically.
model RecipeLine {
  id          Int     @id @default(autoincrement())
  menuItemId  Int
  stockItemId Int
  quantity    Decimal

  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([menuItemId, stockItemId])
  @@map("recipe_lines")
}

// ── Audit & floor signals ───────────────────────────────────────────────
// Append-only record of money-sensitive actions (discounts, voids, cancels,
// reopened bills, shift closes, stock corrections). Never updated or deleted.
model AuditLog {
  id        Int      @id @default(autoincrement())
  cafeId    Int
  actorId   Int?
  actorName String?
  action    String
  entity    String
  entityId  Int?
  details   Json?
  createdAt DateTime @default(now())

  cafe Cafe @relation(fields: [cafeId], references: [id])

  @@index([cafeId, createdAt])
  @@map("audit_logs")
}

// "Call waiter" / "Request bill" taps from the QR page. Shows as a badge on
// the floor view until a staff member resolves it.
model TableRequest {
  id           Int              @id @default(autoincrement())
  cafeId       Int
  tableId      Int
  type         TableRequestType
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?
  resolvedById Int?

  cafe  Cafe            @relation(fields: [cafeId], references: [id])
  table RestaurantTable @relation(fields: [tableId], references: [id])

  @@index([cafeId, resolvedAt])
  @@map("table_requests")
}

// ── Plans ───────────────────────────────────────────────────────────────
// What each subscription plan includes, editable by the superadmin in
// /platform/plans instead of being hardcoded. One row per plan key. A null
// limit means "unlimited". A cafe on trial gets the `premium` row (trial =
// "try everything"). Loaded into an in-memory cache by PlansService so the
// permission checks in subscription/plan-limits.ts stay synchronous.
model PlanConfig {
  id           Int              @id @default(autoincrement())
  key          SubscriptionPlan @unique
  name         String
  description  String?
  monthlyPrice Decimal
  // Yearly price = monthlyPrice * yearlyMonths ("pay 10, get 12").
  yearlyMonths Int              @default(10)
  maxStaff     Int?
  maxMenuItems Int?
  maxTables    Int?
  qrOrdering   Boolean          @default(false)
  reports      Boolean          @default(false)
  inventory    Boolean          @default(false)
  tableGame    Boolean          @default(false)
  updatedAt    DateTime         @updatedAt

  @@map("plan_configs")
}
