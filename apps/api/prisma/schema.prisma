// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  cashier
  waiter
}

enum TableStatus {
  free
  occupied
  reserved
}

enum OrderType {
  dine_in
  takeaway
}

enum OrderStatus {
  pending
  preparing
  served
  billed
  paid
  cancelled
}

enum OrderItemStatus {
  pending
  ready
  served
}

enum PaymentMethod {
  cash
  esewa_qr
  khalti_qr
  fonepay_qr
}

// The tenant. Every cafe running on this deployment gets one row here, and
// (almost) every other model hangs off a cafeId so one cafe's data is never
// visible to another. `slug` is what identifies a cafe in the URL
// (/c/:slug/login) since staff log in with a 4-digit PIN, not an email --
// the slug is how the app knows *which* cafe's staff list to show.
// A superadmin who can manage cafes through the internal /platform panel.
// Deliberately separate from User (per-cafe staff, PIN login) -- platform
// users aren't scoped to any cafe and authenticate with a real
// username/password instead.
model PlatformUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("platform_users")
}

model Cafe {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // VAT settings -- opt-in per cafe. Non-VAT cafes leave vatEnabled false
  // and the billing/receipt logic stays exactly as before. VAT-registered
  // cafes set vatEnabled true, vatRate (default 13 for Nepal), and panNumber.
  vatEnabled Boolean  @default(false)
  vatRate    Decimal  @default(13)
  panNumber      String?
  lastBillNumber Int     @default(0)

  users          User[]
  tables         RestaurantTable[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  orders         Order[]

  @@map("cafes")
}

model User {
  id       Int     @id @default(autoincrement())
  cafeId   Int
  name     String
  pinHash  String
  role     Role
  isActive Boolean @default(true)

  cafe   Cafe    @relation(fields: [cafeId], references: [id])
  orders Order[]

  // A name only has to be unique within its own cafe -- "Sita" can work at
  // two different cafes on the same platform.
  @@unique([cafeId, name])
  @@map("users")
}

model RestaurantTable {
  id          Int         @id @default(autoincrement())
  cafeId      Int
  tableNumber String
  capacity    Int
  status      TableStatus @default(free)

  // Printed as a QR code -- the *token*, not the table id or tableNumber,
  // is what grants access to /c/:slug/order/:qrToken, so a customer can't
  // reach (or guess their way into) another table's order by trying
  // sequential numbers. Rotatable via the admin "regenerate QR" action if
  // a printed code is ever compromised.
  qrToken String @unique @default(cuid())

  cafe   Cafe    @relation(fields: [cafeId], references: [id])
  orders Order[]

  @@unique([cafeId, tableNumber])
  @@map("restaurant_tables")
}

model MenuCategory {
  id        Int    @id @default(autoincrement())
  cafeId    Int
  name      String
  sortOrder Int

  cafe      Cafe       @relation(fields: [cafeId], references: [id])
  menuItems MenuItem[]

  @@unique([cafeId, name])
  @@map("menu_categories")
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  cafeId      Int
  name        String
  price       Decimal
  isAvailable Boolean  @default(true)
  categoryId  Int

  // Inventory tracking is opt-in per item (trackStock) -- most cafe menu
  // items (drinks made to order, say) never run out in a way worth
  // tracking, so items default to untracked rather than forcing every
  // item to carry a meaningless stock count. stockQuantity/
  // lowStockThreshold are only meaningful once trackStock is true.
  trackStock        Boolean @default(false)
  stockQuantity     Int     @default(0)
  lowStockThreshold Int     @default(5)

  cafe       Cafe         @relation(fields: [cafeId], references: [id])
  category   MenuCategory @relation(fields: [categoryId], references: [id])
  modifiers  Modifier[]
  orderItems OrderItem[]

  @@unique([cafeId, name])
  @@map("menu_items")
}

model Modifier {
  id         Int     @id @default(autoincrement())
  name       String
  priceDelta Decimal
  menuItemId Int

  // Scoped to its cafe transitively through menuItem -- a modifier never
  // needs to be looked up on its own without its parent item, so a direct
  // cafeId here would just be a redundant column to keep in sync.
  menuItem           MenuItem            @relation(fields: [menuItemId], references: [id])
  orderItemModifiers OrderItemModifier[]

  @@map("modifiers")
}

model Order {
  id        Int         @id @default(autoincrement())
  cafeId    Int
  orderType OrderType
  status    OrderStatus @default(pending)
  total     Decimal?
  // Set at bill-generation time. Only populated when cafe.vatEnabled.
  subtotal  Decimal?
  vatAmount  Decimal?
  billNumber Int?
  createdAt DateTime    @default(now())
  tableId   Int
  // Nullable: a customer placing their own order via table QR has no
  // waiter to attribute it to yet. Everything else about the order works
  // exactly the same either way -- staff still confirm, cook, serve, and
  // bill it through the normal flow.
  waiterId  Int?
  notes     String?

  cafe       Cafe            @relation(fields: [cafeId], references: [id])
  table      RestaurantTable @relation(fields: [tableId], references: [id])
  waiter     User?           @relation(fields: [waiterId], references: [id])
  orderItems OrderItem[]
  payments   Payment[]

  @@map("orders")
}

model OrderItem {
  id         Int             @id @default(autoincrement())
  quantity   Int             @default(1)
  price      Decimal
  status     OrderItemStatus @default(pending)
  orderId    Int
  menuItemId Int

  // Scoped transitively through order, same reasoning as Modifier above.
  order              Order               @relation(fields: [orderId], references: [id])
  menuItem           MenuItem            @relation(fields: [menuItemId], references: [id])
  orderItemModifiers OrderItemModifier[]

  @@map("order_items")
}

model OrderItemModifier {
  id          Int @id @default(autoincrement())
  orderItemId Int
  modifierId  Int

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  modifier  Modifier  @relation(fields: [modifierId], references: [id])

  @@unique([orderItemId, modifierId])
  @@map("order_item_modifiers")
}

model Payment {
  id      Int           @id @default(autoincrement())
  amount  Decimal
  method  PaymentMethod
  paidAt  DateTime      @default(now())
  orderId Int

  // Scoped transitively through order, same reasoning as Modifier above.
  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}
